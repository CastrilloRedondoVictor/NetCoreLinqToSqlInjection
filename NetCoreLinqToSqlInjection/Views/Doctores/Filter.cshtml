@model List<Doctor>

<h1>Doctores por especialidad</h1>
<p>
    <a class="btn btn-outline-primary" asp-controller="Doctores" asp-action="Index">
        Volver
    </a>
</p>

<h3>Filtrar</h3>
<form method="post">
    <div class="mb-3">
        <label class="form-label">Especialidad</label>
        <select class="form-control" name="especialidad">
            @foreach(Doctor doc in (List<Doctor>) ViewData["DOCTORES"]) {
                <option value="@doc.Especialidad">@doc.Especialidad</option>
                }
        </select>
    </div>
    <button class="btn btn-primary">Filtrar</button>
</form>


@if(Model != null) {
    <table class="table table-striped">
        <thead>
            <tr>
                <th>DoctorId</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Salario</th>
                <th>Hospital</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doctor in Model)
            {
                <tr>
                    <td>@doctor.DoctorNo</td>
                    <td>@doctor.Apellido</td>
                    <td>@doctor.Especialidad</td>
                    <td>@doctor.Salario</td>
                    <td>@doctor.HospitalCod</td>
                    <td>
                        <a class="btn btn-warning" asp-controller="Doctores" asp-action="Update" asp-route-iddoctor="@doctor.DoctorNo">Actualizar</a>
                        <a class="btn btn-danger" asp-controller="Doctores" asp-action="Delete" asp-route-iddoctor="@doctor.DoctorNo">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}