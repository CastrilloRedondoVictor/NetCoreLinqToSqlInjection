@model List<Doctor>

<h1>Doctores</h1>
<p>
    <a class="btn btn-outline-primary" asp-controller="Doctores" asp-action="Create">
        Nuevo doctor
    </a>
</p>
<p>
    <a class="btn btn-outline-primary" asp-controller="Doctores" asp-action="Filter">
        Filtrar por especialidad
    </a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>DoctorId</th>
            <th>Apellido</th>
            <th>Especialidad</th>
            <th>Salario</th>
            <th>Hospital</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.DoctorNo</td>
                <td>@doctor.Apellido</td>
                <td>@doctor.Especialidad</td>
                <td>@doctor.Salario</td>
                <td>@doctor.HospitalCod</td>
                <td>
                    <a class="btn btn-warning" asp-controller="Doctores" asp-action="Update" asp-route-iddoctor="@doctor.DoctorNo">Actualizar</a>
                    <a class="btn btn-danger" asp-controller="Doctores" asp-action="Delete" asp-route-iddoctor="@doctor.DoctorNo">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>